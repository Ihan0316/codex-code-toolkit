{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "EnterPlanMode|update_plan",
        "hooks": [
          {
            "type": "command",
            "command": "& <PYTHON> <ADAPTER> plan; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit|apply_patch|exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "& <PYTHON> <ADAPTER> ownership; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "& <PYTHON> <ADAPTER> dangerous-command; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "& <PYTHON> <IMPROVE_PROMPT>; exit $LASTEXITCODE",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "& <NODE> <CAVEMAN>; exit $LASTEXITCODE",
            "timeout": 5,
            "statusMessage": "caveman ultra 재주입..."
          },
          {
            "type": "command",
            "command": "& <PYTHON> <ADAPTER> context-cap; exit $LASTEXITCODE",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "& <PYTHON> <ADAPTER> caveman-mode; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "& <PYTHON> <ADAPTER> board; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "& <PYTHON> <ADAPTER> session-context; exit $LASTEXITCODE",
            "timeout": 25
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "& <PYTHON> <ADAPTER> bootstrap; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "& <PYTHON> <ADAPTER> caveman-mode; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "& <PYTHON> <ADAPTER> bom; exit $LASTEXITCODE",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
